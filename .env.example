# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000; Railway injects PORT automatically).
PORT="3000"

# TELEGRAM_BOT_TOKEN: Optional Telegram Bot token from @BotFather for live CRM notifications & bot webhook.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Optional Telegram chat or channel ID where new leads & orders are forwarded.
TELEGRAM_CHAT_ID=""

# DATA_DIR: Optional persistent folder path for SQLite DB (e.g. /data when mounting a Railway Volume).
DATA_DIR=""

# ADMIN_LOGIN: Master administrator login for CRM access (defaults to "admin").
ADMIN_LOGIN=admin

# ADMIN_PASSWORD: Master administrator password for CRM login. If left empty, set on first visit via CRM setup.
ADMIN_PASSWORD=

# ADMIN_EMAILS: Comma-separated Google emails allowed to sign in to Admin/CRM (optional).
ADMIN_EMAILS=

# META_PIXEL_ID: Optional Meta (Facebook) Pixel ID for storefront conversion tracking.
META_PIXEL_ID=

# GA4_MEASUREMENT_ID: Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
GA4_MEASUREMENT_ID=


