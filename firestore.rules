rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || request.auth.token.email == 'dzendeco25@gmail.com'
      );
    }

    // Standalone static validation blueprint (no DB reads)
    function isValidProductReview(data) {
      return data.keys().hasAll([
          'productId',
          'authorUid',
          'authorName',
          'rating',
          'comment',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'productId',
          'authorUid',
          'authorName',
          'rating',
          'comment',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.productId)
        && isValidId(data.authorUid)
        && data.authorName is string
        && data.authorName.size() >= 2
        && data.authorName.size() <= 80
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() >= 3
        && data.comment.size() <= 1000
        && data.status in ['published', 'hidden']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /product_reviews/{reviewId} {
      allow get: if isValidId(reviewId)
        && (
          existing().status == 'published'
          || (isVerifiedUser() && existing().authorUid == request.auth.uid)
          || isAdmin()
        );

      allow list: if existing().status == 'published';

      allow create: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidProductReview(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().status == 'published'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(reviewId)
        && isValidProductReview(incoming())
        && incoming().productId == existing().productId
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1: Admin moderation
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Tier 2: Original author editing their own published review
          (
            existing().authorUid == request.auth.uid
            && existing().status == 'published'
            && incoming().status == 'published'
            && incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'rating', 'comment', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(reviewId)
        && (existing().authorUid == request.auth.uid || isAdmin());
    }

    match /admins/{adminId} {
      allow get: if isVerifiedUser()
        && isValidId(adminId)
        && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
