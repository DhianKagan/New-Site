{
  "entities": {
    "ProductReview": {
      "title": "ProductReview",
      "description": "Public customer rating and text review for a catalog product without PII.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Catalog product identifier matching ^[a-zA-Z0-9_\\-]+$.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the verified review author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Public display name shown alongside the review.",
          "minLength": 2,
          "maxLength": 80
        },
        "rating": {
          "type": "integer",
          "description": "Integer star rating from 1 to 5."
        },
        "comment": {
          "type": "string",
          "description": "Customer review text.",
          "minLength": 3,
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Moderation state of the review.",
          "enum": ["published", "hidden"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the review was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the review was last updated."
        }
      },
      "required": [
        "productId",
        "authorUid",
        "authorName",
        "rating",
        "comment",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Trusted administrator marker document managed out-of-band.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Assigned administrative role.",
          "enum": ["admin"]
        }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/product_reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/ProductReview"
      },
      "description": "Public customer reviews for catalog products."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Read-only admin registry used by Firestore security rules."
    }
  }
}
